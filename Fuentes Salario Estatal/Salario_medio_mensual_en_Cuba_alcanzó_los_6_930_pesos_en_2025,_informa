@charset "utf-8";

.dialog { position: relative; z-index: 2; display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; max-height: 100%; max-width: 100%; box-sizing: border-box; padding: 16px; margin: 0px auto; overflow: hidden auto; font-size: 1.3rem; color: var(--tffc2fd3a644f6275); background-color: var(--t518e925f61bdcb91); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; }

.dialog.modern-dialog { box-shadow: rgba(0, 0, 0, 0.25) 0px 0px 24px 12px; }

.dialog.rounded-container { border-radius: 12px; }

.dialog.modern-dialog-layout { padding: 0px; border-radius: 24px; }

.dialog-body { overflow: hidden auto; max-height: 100vh; }

.dialog.scrollable .dialog-body { overflow: visible; max-height: unset; }

.dialog-container { position: fixed; inset: 0px; display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; z-index: 4; }

.dialog-header { display: flex; -webkit-box-orient: vertical; -webkit-box-direction: normal; flex-direction: column; }

.dialog-buttons, .dialog-header { flex-shrink: 0; }

.dialog-buttons { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: end; justify-content: flex-end; margin-top: 12px; }

.dialog-buttons > * { margin-left: 8px; }

.dialog-buttons > :first-child { margin-left: 0px; }

.dialog-flex-button { -webkit-box-flex: 1; flex: 1 1 0%; }

.dialog-flex-button .button-with-icon.compact { margin: 0px; }

.dialog-body a, .dialog-header a { color: var(--t2d807bb79e75606d); }

.dialog-body ytm-menu-item a { color: currentcolor; }

@media (min-width: 330px) and (min-height: 330px) {
  .dialog { min-width: 250px; max-width: 356px; }
  .dialog-container { margin: 0px 40px; padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
}

.dialog-fullscreen { min-width: 100%; min-height: 100%; margin: 0px; padding: 0px; height: 1px; }

.dialog-fullscreen > .dialog-body { height: 100%; }

.dialog.modern-dialog-layout.dialog-fullscreen { border-radius: 0px; }

.dialog-container.dialog-fullscreen { margin: 0px; }

@-webkit-keyframes spinner { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

@keyframes spinner { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(1turn); }
}

.spinnerWrapper { display: flex; -webkit-box-align: center; align-items: center; }

.spinner { display: block; box-sizing: border-box; margin: 12px auto; width: 32px; height: 32px; border-radius: 50%; border-width: 2px; border-style: solid; border-color: rgb(102, 102, 102) rgb(238, 238, 238) rgb(238, 238, 238); border-image: none; animation: 0.8s linear 0s infinite normal none running spinner; }

.spinner > .hidden { display: none; }

.spinner:not([hidden]) { color: rgb(51, 51, 51); font-size: 1.6rem; }

button { padding: 0px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; outline: none; font: inherit; text-transform: inherit; color: inherit; background: transparent; }

html { color: var(--tffc2fd3a644f6275); background-color: var(--t3e41d7b17b187f69); font-size: 10px; font-family: Roboto, Arial, sans-serif; }

body { margin: 0px; padding: 0 env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); font-size: 1.2rem; overflow-x: hidden; }

[hidden][hidden] { display: none; visibility: hidden; }

ytm-app > .spinner { margin-top: 100px; }

ytm-header { display: block; }

header { height: 48px; }

.player-container { position: absolute; top: 48px; right: env(safe-area-inset-right); left: env(safe-area-inset-left); overflow: hidden; z-index: 2; }

[has-player-custom-control="true"] .player-container { overflow: visible !important; }

#player.inline-player-hidden, .inline-player-hidden { opacity: 0; pointer-events: none; }

.player-container .player-size, ytm-watch .player-size { position: relative; width: 100%; padding-bottom: 56.25%; overflow: hidden; }

.player-container #player.player-size, ytm-watch .player-size { background-color: rgb(0, 0, 0); }

.player-cinematics { position: absolute; inset: 0px; pointer-events: none; background: rgb(0, 0, 0); }

.player-cinematics ~ #player.player-size, .player-cinematics ~ .player-size { background-color: transparent; }

.page-shorts .player-container .player-size, .page-shorts ytm-watch .player-size { padding-bottom: 0px; }

.player-container .player-api { display: flex; -webkit-box-align: center; align-items: center; -webkit-box-pack: center; justify-content: center; }

.player-api[hidden], .player-api[loading="true"], .player-api[playable="false"] { display: none; }

#player.inline-on-thumbnail { padding: 0px; position: absolute; inset: 0px; }

.player-container .html5-video-player { position: absolute; inset: 0px; }

ytm-app { display: block; overflow-x: hidden; }

[has-soft-bar="true"] ytm-app { padding-bottom: 30px; }

